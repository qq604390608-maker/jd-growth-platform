{"group":"g1","title":"item1：varchar(24) 存入 200 字符 —— 是否截断 / 报错 / 读回长度","steps":[{"label":"① varchar(24) 写入 200 字符","sql":"INSERT INTO probe_type (tag, c_v24) VALUES (?, ?)","params":[{"jsType":"string","value":"len200"},{"jsType":"string","value":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}],"ok":true,"rows":[],"meta":{"served_by":"miniflare.db","duration":0,"changes":1,"last_row_id":1,"changed_db":true,"size_after":65536,"rows_read":0,"rows_written":1}},{"label":"② 读回：字符数 / 字节数 / 存储类 / 首尾各 5 字符（尾部完整=未截断）","sql":"SELECT tag, length(c_v24) AS chars, length(cast(c_v24 AS blob)) AS bytes, typeof(c_v24) AS storage_class, substr(c_v24,1,5) AS head, substr(c_v24,-5) AS tail FROM probe_type WHERE tag = ?","params":[{"jsType":"string","value":"len200"}],"ok":true,"rows":[{"tag":"len200","chars":200,"bytes":200,"storage_class":"text","head":"xxxxx","tail":"xxxxx"}],"meta":{"served_by":"miniflare.db","duration":0,"changes":0,"last_row_id":1,"changed_db":false,"size_after":65536,"rows_read":1,"rows_written":0}},{"label":"③ varchar(200) 写入 300 字符","sql":"INSERT INTO probe_type (tag, c_v200) VALUES (?, ?)","params":[{"jsType":"string","value":"len300"},{"jsType":"string","value":""}],"ok":true,"rows":[],"meta":{"served_by":"miniflare.db","duration":0,"changes":1,"last_row_id":2,"changed_db":true,"size_after":65536,"rows_read":0,"rows_written":1}},{"label":"④ 读回 varchar(200) 列","sql":"SELECT tag, length(c_v200) AS chars, typeof(c_v200) AS storage_class FROM probe_type WHERE tag = ?","params":[{"jsType":"string","value":"len300"}],"ok":true,"rows":[{"tag":"len300","chars":300,"storage_class":"text"}],"meta":{"served_by":"miniflare.db","duration":0,"changes":0,"last_row_id":2,"changed_db":false,"size_after":65536,"rows_read":2,"rows_written":0}},{"label":"⑤ varchar(24) 写入恰好 24 字符（边界值）","sql":"INSERT INTO probe_type (tag, c_v24) VALUES (?, ?)","params":[{"jsType":"string","value":"len24"},{"jsType":"string","value":"xxxxxxxxxxxxxxxxxxxxxxxx"}],"ok":true,"rows":[],"meta":{"served_by":"miniflare.db","duration":0,"changes":1,"last_row_id":3,"changed_db":true,"size_after":65536,"rows_read":0,"rows_written":1}},{"label":"⑥ varchar(24) 写入 30 个中文字符（30 字符 / 90 字节）","sql":"INSERT INTO probe_type (tag, c_v24) VALUES (?, ?)","params":[{"jsType":"string","value":"cn30"},{"jsType":"string","value":"中中中中中中中中中中中中中中中中中中中中中中中中中中中中中中"}],"ok":true,"rows":[],"meta":{"served_by":"miniflare.db","duration":1,"changes":1,"last_row_id":4,"changed_db":true,"size_after":65536,"rows_read":0,"rows_written":1}},{"label":"⑦ 读回中文行：字符数 / 字节数","sql":"SELECT tag, length(c_v24) AS chars, length(cast(c_v24 AS blob)) AS bytes, typeof(c_v24) AS storage_class FROM probe_type WHERE tag = ?","params":[{"jsType":"string","value":"cn30"}],"ok":true,"rows":[{"tag":"cn30","chars":30,"bytes":90,"storage_class":"text"}],"meta":{"served_by":"miniflare.db","duration":0,"changes":0,"last_row_id":4,"changed_db":false,"size_after":65536,"rows_read":4,"rows_written":0}},{"label":"⑧ 统计：有多少行实际超出声明长度 24","sql":"SELECT count(*) AS rows_over_24 FROM probe_type WHERE c_v24 IS NOT NULL AND length(c_v24) > 24","params":[],"ok":true,"rows":[{"rows_over_24":2}],"meta":{"served_by":"miniflare.db","duration":0,"changes":0,"last_row_id":4,"changed_db":false,"size_after":65536,"rows_read":4,"rows_written":0}},{"label":"⑨ 对同一列做 MIN/MAX 长度：声明长度与实存长度是否脱钩","sql":"SELECT min(length(c_v24)) AS min_chars, max(length(c_v24)) AS max_chars FROM probe_type WHERE c_v24 IS NOT NULL","params":[],"ok":true,"rows":[{"min_chars":24,"max_chars":200}],"meta":{"served_by":"miniflare.db","duration":0,"changes":0,"last_row_id":4,"changed_db":false,"size_after":65536,"rows_read":4,"rows_written":0}}]}